rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /settings/{docId} { allow read, write: if request.auth != null; }
    match /accessUsers/{docId} { allow read, write: if request.auth != null; }
    match /customers/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.createdAt is timestamp
        && request.time < resource.data.createdAt + duration.value(24, 'h');
      allow delete: if request.auth != null;
    }
    match /repairing/{docId} { allow read, write: if request.auth != null; }
    match /auditLogs/{docId} { allow read, write: if request.auth != null; }
    match /secondHand/{docId} { allow read, write: if request.auth != null; }
    match /accessories/{docId} { allow read, write: if request.auth != null; }
    match /recentlyDeleted/{docId} { allow read, write: if request.auth != null; }
  }
}
